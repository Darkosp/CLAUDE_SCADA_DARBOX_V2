# Copy to deploy/cloud/.env (not committed) and fill in. Every secret is required; Compose refuses
# to start and names the one that is missing. Passwords must not contain ';'.

# The commit whose images to run, as printed by deploy/build-images.sh (e.g. 4bc729c).
SCADA_IMAGE_TAG=

# The privileged database role 'scada'. Given only to the database and the migrator.
SCADA_DB_ADMIN_PASSWORD=

# The application role 'scada_app' the Gateway connects as. The migrator sets it.
SCADA_APP_DB_PASSWORD=

# The first Admin, created only while no user exists. At least 12 characters. Clear both once the
# account exists.
SCADA_INITIAL_ADMIN_USERNAME=
SCADA_INITIAL_ADMIN_PASSWORD=

# Where ca.crt, broker.crt/.key and scada-gateway.crt/.key are on this host (deploy/cloud/certs.sh
# makes them). Not ca.key: that stays on the machine that signs certificates.
SCADA_CERT_DIR=

# Not secrets. The web client and API; the edges' TLS port.
SCADA_HTTP_PORT=8080
SCADA_BROKER_PORT=8883
