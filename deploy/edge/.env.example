# Copy to deploy/edge/.env (not committed) and fill in.

# The commit whose images to run, as printed by deploy/build-images.sh.
SCADA_IMAGE_TAG=

# This edge's name: exactly the name its certificate was issued under (deploy/cloud/certs.sh client <name>).
SCADA_EDGE_ID=

# The broker, as named in its certificate, and its edges' port.
SCADA_BROKER_HOST=
SCADA_BROKER_PORT=8883

# Holds ca.crt, <SCADA_EDGE_ID>.crt and <SCADA_EDGE_ID>.key. Not ca.key.
SCADA_EDGE_CERT_DIR=

# There is nothing else to fill in. This edge's devices, their addresses and the Gateway's tag ids
# are derived by the cloud and published on the edge's own topic; the edge reads nothing until they
# arrive, and keeps reading the last set it accepted through any outage after that (ADR-0019).
