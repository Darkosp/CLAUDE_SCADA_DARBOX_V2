<Project>
  <!--
    dotnet publish src/EdgeAgent -p:PublishProfile=linux-arm64

    The same build as linux-x64, for the hardware that will be at a plant: self-contained on the
    ordinary runtime, neither Native AOT nor trimmed (ADR-0018) — the OPC UA module fails under
    both, on this architecture as on the other. src/EdgeAgent/Dockerfile picks the profile from
    the platform it is building for.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
</Project>
