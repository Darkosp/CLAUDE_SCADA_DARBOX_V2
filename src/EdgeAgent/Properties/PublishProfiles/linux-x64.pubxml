<Project>
  <!--
    dotnet publish src/EdgeAgent -p:PublishProfile=linux-x64

    Self-contained on the ordinary runtime — no .NET install needed on the edge machine — and
    neither Native AOT nor trimmed (ADR-0018): the OPC UA module fails under both. linux-arm64
    is the same build for the hardware that has to be at a plant; the Dockerfile chooses between
    the two by the platform the image is being built for, so a build on the edge machine itself
    needs no flag.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
</Project>
