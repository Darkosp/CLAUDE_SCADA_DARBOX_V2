<Project>
  <!--
    dotnet publish src/EdgeAgent -p:PublishProfile=linux-x64

    Self-contained on the ordinary runtime — no .NET install needed on the edge machine — and
    neither Native AOT nor trimmed (ADR-0018): the OPC UA module fails under both. A linux-arm64
    profile is not provided yet on purpose: that target is unverified (ADR-0018) and has to be
    built and run before any edge hardware is chosen.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
</Project>
