{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // A development run serves HTTP, and says so through the SAME setting a production deployment
  // behind a proxy uses (ADR-0028 4). There is deliberately no development-only code path: a path
  // that exists only for development is a path that exists to be forgotten. What makes this safe is
  // that the shipped image does not run in the Development environment.
  "Server": {
    "TlsTerminatedUpstream": true
  }
}
