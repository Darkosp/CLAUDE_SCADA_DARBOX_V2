<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- An in-process broker for the MQTT end-to-end test; the deployed broker is Mosquitto (ADR-0017). -->
    <PackageReference Include="MQTTnet.Server" Version="5.2.0.1603" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Gateway\ScadaDarbox.Gateway.csproj" />
    <!-- The real edge buffer and uplink, driven against this Gateway end to end (ADR-0017). -->
    <ProjectReference Include="..\..\src\EdgeAgent\ScadaDarbox.EdgeAgent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The edge agent is an application with an appsettings.json of its own, and referencing it
      copies that file here too, where it overwrote the Gateway's — which StartupCheckTests caught.
      A project's own item wins over a transitive one with the same target path, so the Gateway's
      configuration is named here explicitly.
    -->
    <None Include="..\..\src\Gateway\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>